PORT=3000
PUBLIC_BASE_URL=https://api.gaffarindia.in
WATI_API_ENDPOINT=https://live-mt-server.wati.io
WATI_API_TOKEN=your_wati_api_token_here
WATI_CHANNEL_NUMBER=919999999999
ADMIN_SECRET=global_admin_secret_gaffarindia
EVENTS_MAX=500
LOG_LEVEL=dev
BODY_LIMIT=10mb
DEFAULT_COUNTRY_CODE=91

# Optional: forward all received webhook events to one or more URLs.
# Default format is a JSON event envelope. Use "raw" to relay the original payload.
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_FORMAT=event
WEBHOOK_FORWARD_TIMEOUT_MS=10000

# Optional: source-specific forward targets.
WEBHOOK_FORWARD_WATI_URL=
WEBHOOK_FORWARD_SHIPROCKET_URL=
WEBHOOK_FORWARD_SHIPPING_URL=
WEBHOOK_FORWARD_WOOCOMMERCE_URL=

# Optional: source-specific receiver secrets.
# For WATI/Shiprocket, pass this as ?secret=... or X-Webhook-Secret.
# For WooCommerce, use this as the WooCommerce webhook secret.
WEBHOOK_SECRET_WATI=
WEBHOOK_SECRET_SHIPROCKET=
WEBHOOK_SECRET_SHIPPING=
WEBHOOK_SECRET_WOOCOMMERCE=
